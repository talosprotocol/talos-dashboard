# Talos Dashboard - Production Environment Template
# Copy this to .env.production for production builds

# Data Source Mode
# Default: HTTP (production mode)
# Set to MOCK only for development/testing
# NEXT_PUBLIC_TALOS_DATA_MODE=HTTP

# Backend Service URLs
# These should point to your production Kubernetes services
TALOS_AUDIT_URL=http://talos-audit-service:8001
TALOS_GATEWAY_URL=http://talos-gateway-service:8000
TALOS_CONNECTOR_URL=http://talos-mcp-connector:8082
TALOS_CHAT_URL=http://talos-chat-service:8100
TALOS_AIOPS_URL=http://talos-aiops-service:8200

# Public browser-facing configuration
NEXT_PUBLIC_API_URL=https://talosprotocol.com
NEXT_PUBLIC_TALOS_DATA_MODE=HTTP
NEXT_PUBLIC_APP_ORIGIN=https://talosprotocol.com
APP_ORIGIN=https://talosprotocol.com
NEXT_PUBLIC_RP_ID=talosprotocol.com

# Authentication
ADMIN_EMAIL=admin@talosprotocol.com
TALOS_DEFAULT_CREDS_ACTIVE=false

# Next.js
NODE_ENV=production
