# Talos Dashboard Environment Configuration
# Copy to .env.local for local development

# =============================================================================
# Downstream Service URLs (Server-Side Only)
# =============================================================================
# These are used by the /api/status/aggregate route to check service health.
# They are NOT exposed to the browser.

# Talos Gateway - Main API gateway
TALOS_GATEWAY_URL=http://localhost:8001

# Talos Audit Service - Event storage and verification
TALOS_AUDIT_URL=http://localhost:8002

# Talos Config Service
TALOS_CONFIGURATION_URL=http://localhost:8003

# Talos MCP Connector - MCP protocol bridge
TALOS_CONNECTOR_URL=http://localhost:8082

# Secure Chat Agent
TALOS_CHAT_URL=http://localhost:8100

# DevOps Agent
TALOS_AIOPS_URL=http://localhost:8200

# Regional Configuration
TALOS_REGION=us

# Ollama - Local LLM inference (optional)
OLLAMA_URL=http://localhost:11434

# =============================================================================
# Public Configuration (Exposed to Browser)
# =============================================================================

# Dashboard version (injected at build time)
NEXT_PUBLIC_DASHBOARD_VERSION=0.1.20

# Upstream API base for client-side HTTP mode
NEXT_PUBLIC_API_URL=http://localhost:8001

# Dashboard data mode
NEXT_PUBLIC_TALOS_DATA_MODE=HTTP

# App origin for local auth flows
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_RP_ID=localhost

# Dashboard auth/setup persistence
DATABASE_URL=postgres://postgres:password@localhost:5432/talos

# Contract hash for integrity verification (optional)
# NEXT_PUBLIC_CONTRACT_HASH=abc123...

# Polling interval for status checks (milliseconds)
NEXT_PUBLIC_STATUS_POLL_INTERVAL=10000

# Stale threshold - show STALE badge if data older than this (milliseconds)
NEXT_PUBLIC_STATUS_STALE_THRESHOLD=30000

# =============================================================================
# Authentication
# =============================================================================
# Local development defaults to no-login mode so the dashboard can run without
# WebAuthn, cookies, or the dashboard database. Production deployments should set
# TALOS_AUTH_REQUIRED=true to restore passkey/session enforcement.
TALOS_AUTH_REQUIRED=false
# Backward-compatible override: TALOS_DISABLE_LOGIN=true also disables login.
# TALOS_DISABLE_LOGIN=true
AUTH_SECRET=changeme_openssl_rand_base64_32
AUTH_COOKIE_HMAC_SECRET=base64url_encoded_32_byte_secret
TALOS_BOOTSTRAP_TOKEN=changeme_bootstrap_token
TALOS_SERVICE_TOKEN=changeme_service_token
TALOS_DEFAULT_CREDS_ACTIVE=false
ADMIN_EMAIL=admin@talosprotocol.com
ADMIN_PASSWORD=change_me_in_prod
